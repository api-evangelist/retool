{
  "opencollection": "1.0.0",
  "info": {
    "name": "Retool Management Apps Resources API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Resources",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Resources",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.retool.com/v1/resources"
          },
          "docs": "Retrieves all data source resource connections configured in the Retool organization, including databases, REST APIs, and third-party service integrations."
        }
      ]
    }
  ],
  "bundled": true
}